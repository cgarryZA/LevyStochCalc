import Mathlib.MeasureTheory.MeasurableSpace.Constructions

/-!
# The σ-algebra generated by a tuple of random variables

The σ-algebra a tuple generates is the join of those its components generate. This is what turns a
finite family of generators into a single vector-valued map, the form that limit arguments for
independence take.

## Main statements

* `comap_pi_eq_iSup` — for a family, `σ(ω ↦ (f i ω)ᵢ) = ⨆ i, σ(f i)`.
* `comap_prod_eq_sup` — for a pair, `σ(ω ↦ (g ω, h ω)) = σ(g) ⊔ σ(h)`.
-/

namespace LevyStochCalc.Probability

variable {Ω : Type*}

/-- The σ-algebra generated by a tuple is the supremum of those generated by its components. -/
theorem comap_pi_eq_iSup {ι : Type*} {𝓨 : ι → Type*} [∀ i, MeasurableSpace (𝓨 i)]
    (f : ∀ i, Ω → 𝓨 i) :
    MeasurableSpace.comap (fun ω i => f i ω) MeasurableSpace.pi
      = ⨆ i, MeasurableSpace.comap (f i) inferInstance := by
  rw [MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  exact iSup_congr fun i => MeasurableSpace.comap_comp

/-- The σ-algebra generated by a pair is the join of those generated by its components. -/
theorem comap_prod_eq_sup {𝓨 𝓩 : Type*} [MeasurableSpace 𝓨] [MeasurableSpace 𝓩]
    (g : Ω → 𝓨) (h : Ω → 𝓩) :
    MeasurableSpace.comap (fun ω => (g ω, h ω)) inferInstance
      = MeasurableSpace.comap g inferInstance ⊔ MeasurableSpace.comap h inferInstance := by
  show MeasurableSpace.comap (fun ω => (g ω, h ω))
      (MeasurableSpace.comap Prod.fst inferInstance ⊔ MeasurableSpace.comap Prod.snd inferInstance)
    = _
  rw [MeasurableSpace.comap_sup, MeasurableSpace.comap_comp, MeasurableSpace.comap_comp]
  rfl

end LevyStochCalc.Probability
