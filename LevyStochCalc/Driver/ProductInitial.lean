import LevyStochCalc.Driver.GaussianInitial

/-!
# A Lévy driver and an independent initial value on a product space

Let `D` be a Lévy driver on `(Ω, P)` and `μ₀` a probability measure on a measurable space `S`.
On the product `Ω × S` under `P ⊗ μ₀` the driver read off the first coordinate,
`LevyDriver.prodRight D μ₀`, is a Lévy driver whose joint natural filtration is the comap of
that of `D` along the first projection. The σ-algebra `σ(Prod.snd)` of the second coordinate is
independent of the σ-algebra generated by that whole filtration, since the coordinates of a
product probability space are independent. So `σ(Prod.snd)` is an initial σ-algebra independent
of the driver, and the second coordinate is an initial value of law `μ₀`.

For `S = ℝ` and `μ₀ = 𝒩(m₀, v)` this is `LevyDriver.prodGaussian`. The second coordinate is then
square integrable, and for `v ≠ 0` it is not almost surely constant: the Gaussian law with nonzero
variance charges no single point.

## Main definitions

* `LevyStochCalc.Driver.LevyDriver.prodRight`: the driver on `Ω × S` under `P ⊗ μ₀` read off the
  first coordinate.

## Main statements

* `LevyStochCalc.Driver.LevyDriver.filtration_prodRight`: its joint filtration is the comap of
  the joint filtration of `D`.
* `LevyStochCalc.Driver.LevyDriver.indep_comap_snd_iSup_filtration_prodRight`: `σ(Prod.snd)` is
  independent of its whole joint filtration.
* `LevyStochCalc.Driver.memLp_snd_prod_gaussianReal`: under `P ⊗ 𝒩(m₀, v)` the second
  coordinate is square integrable.
* `LevyStochCalc.Driver.not_ae_const_snd_prod_gaussianReal`: under `P ⊗ 𝒩(m₀, v)`, `v ≠ 0`, the
  second coordinate is not almost surely constant.
-/

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace LevyStochCalc.Driver

universe u v w

variable {Ω : Type u} [MeasurableSpace Ω] {E : Type v} [MeasurableSpace E]
  {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν] {d : ℕ}
  {S : Type} [MeasurableSpace S]

namespace LevyDriver

/-- The Lévy driver on `Ω × S` under `P ⊗ μ₀` read off the first coordinate. -/
noncomputable def prodRight (D : LevyDriver.{u, v, w} P d ν) (μ₀ : Measure S)
    [IsProbabilityMeasure μ₀] : LevyDriver.{u, v, w} (P.prod μ₀) d ν :=
  D.comap (measurePreserving_fst (μ := P) (ν := μ₀))

variable (D : LevyDriver.{u, v, w} P d ν) (μ₀ : Measure S) [IsProbabilityMeasure μ₀]

/-- The joint filtration of `D.prodRight μ₀` is the comap along the first projection of the
joint filtration of `D`. -/
theorem filtration_prodRight (s : ℝ) :
    (D.prodRight μ₀).filtration s = (D.filtration s).comap Prod.fst :=
  D.filtration_comap _ s

/-- For a Gaussian second factor the driver read off the first coordinate is `prodGaussian`. -/
theorem prodRight_gaussianReal (m₀ : ℝ) (v : ℝ≥0) :
    D.prodRight (gaussianReal m₀ v) = D.prodGaussian m₀ v :=
  rfl

/-- Under `P ⊗ μ₀` the σ-algebra of the second coordinate is independent of the σ-algebra
generated by the whole joint filtration of `D.prodRight μ₀`. -/
theorem indep_comap_snd_iSup_filtration_prodRight :
    Indep (MeasurableSpace.comap (Prod.snd : Ω × S → S) inferInstance)
      (⨆ t, (D.prodRight μ₀).filtration t) (P.prod μ₀) := by
  have hprod : Indep (MeasurableSpace.comap (Prod.snd : Ω × S → S) inferInstance)
      (MeasurableSpace.comap (Prod.fst : Ω × S → Ω) inferInstance) (P.prod μ₀) :=
    (indepFun_prod (μ := P) (ν := μ₀) (X := id) (Y := id) measurable_id measurable_id).symm
  refine indep_of_indep_of_le_right hprod (iSup_le fun t => ?_)
  rw [filtration_prodRight]
  exact MeasurableSpace.comap_mono (D.filtration.le t)

end LevyDriver

/-- Under `P ⊗ 𝒩(m₀, v)` the second coordinate is square integrable. -/
theorem memLp_snd_prod_gaussianReal (m₀ : ℝ) (v : ℝ≥0) :
    MemLp (Prod.snd : Ω × ℝ → ℝ) 2 (P.prod (gaussianReal m₀ v)) :=
  (memLp_id_gaussianReal (μ := m₀) (v := v) 2).comp_measurePreserving
    (measurePreserving_snd (μ := P) (ν := gaussianReal m₀ v))

/-- Under `P ⊗ 𝒩(m₀, v)` with `v ≠ 0` the second coordinate is not almost surely constant. -/
theorem not_ae_const_snd_prod_gaussianReal {m₀ : ℝ} {v : ℝ≥0} (hv : v ≠ 0) :
    ¬ ∃ c : ℝ, (Prod.snd : Ω × ℝ → ℝ) =ᵐ[P.prod (gaussianReal m₀ v)] fun _ => c := by
  rintro ⟨c, hc⟩
  haveI := nullSingletonClass_gaussianReal (μ := m₀) hv
  have h0 : (P.prod (gaussianReal m₀ v)) (Prod.snd ⁻¹' {c}) = 0 := by
    rw [(measurePreserving_snd (μ := P) (ν := gaussianReal m₀ v)).measure_preimage
      (measurableSet_singleton c).nullMeasurableSet]
    exact measure_singleton c
  obtain ⟨x, hx1, hx2⟩ := (hc.and (measure_eq_zero_iff_ae_notMem.1 h0)).exists
  exact hx2 hx1

end LevyStochCalc.Driver
