import LevyStochCalc.Driver.JointFiltration

/-!
# The joint filtration of a Lévy driver is independent of the joint Brownian future

For a Lévy driver `D` and `0 ≤ s`, the joint filtration at `s`, and its `0`-clamped augmentation
by the null sets, are independent of the σ-algebra generated by the increments after `s` of all
the Brownian coordinates at once.

## Main statements

* `LevyDriver.indep_filtration_iSup_future` — for the joint filtration.
* `LevyDriver.indep_augFiltration_iSup_future` — for its augmentation.
-/

open MeasureTheory ProbabilityTheory

namespace LevyStochCalc.Driver

universe u v w

variable {Ω : Type u} [MeasurableSpace Ω] {E : Type v} [MeasurableSpace E]
  {P : Measure Ω} [IsProbabilityMeasure P] {d : ℕ} {ν : Measure E} [SigmaFinite ν]

namespace LevyDriver

variable (D : LevyDriver.{u, v, w} P d ν)

open LevyStochCalc.Brownian LevyStochCalc.Brownian.Multidim

/-- **The joint filtration is independent of the joint Brownian future.** For `0 ≤ s` the
σ-algebra `D.filtration s` is independent of the σ-algebra generated by all the increments
`Wⁱ t − Wⁱ s`, `t > s`, of all the Brownian coordinates. -/
theorem indep_filtration_iSup_future {s : ℝ} (hs : 0 ≤ s) :
    Indep (D.filtration s) (⨆ i : Fin d, ⨆ t ∈ Set.Ioi s,
      MeasurableSpace.comap (fun ω => (D.W.W i).W t ω - (D.W.W i).W s ω) inferInstance) P := by
  have hfut_le : (⨆ i : Fin d, ⨆ t ∈ Set.Ioi s,
      MeasurableSpace.comap (fun ω => (D.W.W i).W t ω - (D.W.W i).W s ω) inferInstance)
      ≤ ⨆ i, Brownian.sigmaBrownian (D.W.W i) :=
    iSup_le fun i => iSup₂_le fun t _ =>
      (Brownian.comap_increment_le_sigmaBrownian (D.W.W i) s t).trans
        (le_iSup (fun j => Brownian.sigmaBrownian (D.W.W j)) i)
  have hB : ⨆ i, Brownian.sigmaBrownian (D.W.W i) ≤ ‹MeasurableSpace Ω› :=
    iSup_le fun i => Brownian.sigmaBrownian_le (D.W.W i)
  have h2 : Indep (Poisson.naturalFiltration D.N s) (D.W.naturalFiltration s
      ⊔ ⨆ i : Fin d, ⨆ t ∈ Set.Ioi s,
        MeasurableSpace.comap (fun ω => (D.W.W i).W t ω - (D.W.W i).W s ω) inferInstance) P :=
    indep_of_indep_of_le_right
      (indep_of_indep_of_le_left D.indep.symm (naturalFiltration_le_sigmaPoisson _ s))
      (sup_le (D.W.naturalFiltration_le_iSup_sigmaBrownian s) hfut_le)
  rw [filtration_apply]
  exact Probability.indep_sup_left_of_indep ((D.W.naturalFiltration).le s)
    ((Poisson.naturalFiltration D.N).le s) (hfut_le.trans hB)
    (D.W.indep_naturalFiltration_iSup_future hs) h2

/-- **The augmented joint filtration is independent of the joint Brownian future.** -/
theorem indep_augFiltration_iSup_future {s : ℝ} (hs : 0 ≤ s) :
    Indep (Brownian.augFiltration D.filtration P s) (⨆ i : Fin d, ⨆ t ∈ Set.Ioi s,
      MeasurableSpace.comap (fun ω => (D.W.W i).W t ω - (D.W.W i).W s ω) inferInstance) P := by
  have hfeq : Brownian.augFiltration D.filtration P s
      = Probability.aug (D.filtration s) ‹MeasurableSpace Ω› P := by
    change Probability.aug (D.filtration (max s 0)) ‹MeasurableSpace Ω› P = _
    rw [max_eq_left hs]
  rw [hfeq]
  exact Probability.indep_aug P (D.indep_filtration_iSup_future hs)

end LevyDriver

end LevyStochCalc.Driver
