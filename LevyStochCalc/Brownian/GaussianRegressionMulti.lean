import LevyStochCalc.Brownian.GaussianRegression
import LevyStochCalc.Brownian.MultidimFiltered

/-!
# Gaussian regression of one Brownian coordinate in several dimensions

Let `W` be a `d`-dimensional Brownian motion and `ℱ` a filtration that is Brownian for every
coordinate and such that `ℱ s` is independent of the σ-algebra generated by the increments after
`s` of all the coordinates. For a coordinate `k`, enlarging `ℱ` by the σ-algebra
`σ(Wʲ : j ≠ k)` of the other coordinates gives a filtration for which `Wᵏ` is still a Brownian
motion. The one-dimensional regression identity then holds for `Wᵏ` and every square-integrable
`Φ` measurable for `ℱ_t ⊔ σ(Wʲ : j ≠ k) ⊔ σ(Wᵏ_T − Wᵏ_t)`:

  `E[Φ (Wᵏ_r − Wᵏ_t)] = (r − t) / (T − t) · E[Φ (Wᵏ_T − Wᵏ_t)]`.

## Main statements

* `supOthers` — the filtration `ℱ ⊔ σ(Wʲ : j ≠ k)`.
* `isBrownianFiltration_supOthers` — `Wᵏ` is a Brownian motion for it.
* `integral_mul_increment_eq_regression_coord` — the regression identity for one coordinate.
-/

open MeasureTheory ProbabilityTheory Filter

namespace LevyStochCalc.Brownian

universe u

variable {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {d : ℕ}

open Multidim

/-- The filtration `ℱ` enlarged at every time by the σ-algebra generated by the coordinates of
`W` other than the `k`-th. -/
noncomputable def supOthers (W : MultidimBrownianMotion P d)
    (ℱ : Filtration ℝ ‹MeasurableSpace Ω›) (k : Fin d) : Filtration ℝ ‹MeasurableSpace Ω› where
  seq t := ℱ t ⊔ ⨆ j ∈ {j : Fin d | j ≠ k}, sigmaBrownian (W.W j)
  mono' _ _ hst := sup_le_sup_right (ℱ.mono hst) _
  le' t := sup_le (ℱ.le t) (iSup₂_le fun j _ => sigmaBrownian_le (W.W j))

theorem supOthers_apply (W : MultidimBrownianMotion P d) (ℱ : Filtration ℝ ‹MeasurableSpace Ω›)
    (k : Fin d) (t : ℝ) :
    supOthers W ℱ k t = ℱ t ⊔ ⨆ j ∈ {j : Fin d | j ≠ k}, sigmaBrownian (W.W j) := rfl

theorem le_supOthers (W : MultidimBrownianMotion P d) (ℱ : Filtration ℝ ‹MeasurableSpace Ω›)
    (k : Fin d) (t : ℝ) : ℱ t ≤ supOthers W ℱ k t := le_sup_left

/-- Every value of a coordinate other than the `k`-th is measurable for `ℱ ⊔ σ(Wʲ : j ≠ k)` at
every time. -/
theorem measurable_supOthers (W : MultidimBrownianMotion P d)
    (ℱ : Filtration ℝ ‹MeasurableSpace Ω›) {j k : Fin d} (hjk : j ≠ k) (t s : ℝ) :
    Measurable[supOthers W ℱ k t] ((W.W j).W s) := by
  have hle : sigmaBrownian (W.W j) ≤ supOthers W ℱ k t :=
    (le_iSup₂_of_le (f := fun i (_ : i ∈ {i : Fin d | i ≠ k}) => sigmaBrownian (W.W i)) j hjk
      le_rfl).trans le_sup_right
  exact (Measurable.of_comap_le (le_iSup (fun s => MeasurableSpace.comap ((W.W j).W s)
    inferInstance) s)).mono hle le_rfl

/-- **The other coordinates do not disturb a coordinate.** If `ℱ` is Brownian for every
coordinate of `W` and `ℱ s` is independent of the increments after `s` of all the coordinates,
then `Wᵏ` is a Brownian motion for `ℱ ⊔ σ(Wʲ : j ≠ k)`. -/
theorem isBrownianFiltration_supOthers (W : MultidimBrownianMotion P d)
    {ℱ : Filtration ℝ ‹MeasurableSpace Ω›} (hcoord : ∀ j, IsBrownianFiltration (W.W j) ℱ)
    (hjoint : ∀ ⦃s : ℝ⦄, 0 ≤ s → Indep (ℱ s) (⨆ i : Fin d, ⨆ t ∈ Set.Ioi s,
      MeasurableSpace.comap (fun ω => (W.W i).W t ω - (W.W i).W s ω) inferInstance) P)
    (k : Fin d) : IsBrownianFiltration (W.W k) (supOthers W ℱ k) where
  measurable t := ((hcoord k).measurable t).mono le_sup_left le_rfl
  indep_future s hs := by
    set fut : Fin d → MeasurableSpace Ω := fun i => ⨆ t ∈ Set.Ioi s,
      MeasurableSpace.comap (fun ω => (W.W i).W t ω - (W.W i).W s ω) inferInstance with hfut
    set S : Set (Fin d) := {j : Fin d | j ≠ k} with hS
    have hfut_le : ∀ i, fut i ≤ sigmaBrownian (W.W i) := fun i =>
      iSup₂_le fun t _ => comap_increment_le_sigmaBrownian (W.W i) s t
    have hfut_le' : ∀ i, fut i ≤ ‹MeasurableSpace Ω› := fun i =>
      (hfut_le i).trans (sigmaBrownian_le (W.W i))
    -- the other coordinates are measurable for the present and their own future increments
    have hothers : (⨆ j ∈ S, sigmaBrownian (W.W j)) ≤ ℱ s ⊔ (⨆ j ∈ S, fut j) := by
      refine iSup₂_le fun j hj => iSup_le fun v => ?_
      refine Measurable.comap_le ?_
      rcases le_or_gt v s with hvs | hsv
      · exact ((hcoord j).measurable v).mono ((ℱ.mono hvs).trans le_sup_left) le_rfl
      · have hinc : Measurable[ℱ s ⊔ (⨆ j ∈ S, fut j)]
            (fun ω => (W.W j).W v ω - (W.W j).W s ω) := by
          refine Measurable.mono (comap_measurable _) ?_ le_rfl
          exact (le_iSup₂_of_le v (Set.mem_Ioi.mpr hsv) le_rfl : _ ≤ fut j).trans
            ((le_iSup₂_of_le j hj le_rfl : fut j ≤ ⨆ j ∈ S, fut j).trans le_sup_right)
        have hWs : Measurable[ℱ s ⊔ (⨆ j ∈ S, fut j)] ((W.W j).W s) :=
          ((hcoord j).measurable s).mono le_sup_left le_rfl
        have e : (W.W j).W v = fun ω => (W.W j).W s ω + ((W.W j).W v ω - (W.W j).W s ω) := by
          funext ω; ring
        rw [e]
        exact hWs.add hinc
    -- the future increments of the other coordinates are independent of those of `Wᵏ`
    have h13 : Indep (⨆ j ∈ S, fut j) (fut k) P :=
      indep_of_indep_of_le_right (indep_of_indep_of_le_left (indep_iSup_sigmaBrownian_ne W k)
        (iSup₂_le fun j hj => (hfut_le j).trans (le_iSup₂_of_le j hj le_rfl))) (hfut_le k)
    have h2 : Indep (ℱ s) ((⨆ j ∈ S, fut j) ⊔ fut k) P :=
      indep_of_indep_of_le_right (hjoint hs)
        (sup_le (iSup₂_le fun j _ => le_iSup fut j) (le_iSup fut k))
    have hind := Probability.indep_sup_left_of_indep
      (iSup₂_le fun j _ => hfut_le' j) (ℱ.le s) (hfut_le' k) h13 h2
    refine indep_of_indep_of_le_left hind ?_
    rw [supOthers_apply]
    exact sup_le le_sup_right (hothers.trans (sup_le le_sup_right le_sup_left))

/-- **Gaussian regression for one coordinate.** Under the hypotheses of
`isBrownianFiltration_supOthers`, for `0 ≤ t < r ≤ T` and a square-integrable `Φ` measurable for
`ℱ_t ⊔ σ(Wʲ : j ≠ k) ⊔ σ(Wᵏ_T − Wᵏ_t)`,
`E[Φ (Wᵏ_r − Wᵏ_t)] = (r − t) / (T − t) · E[Φ (Wᵏ_T − Wᵏ_t)]`. -/
theorem integral_mul_increment_eq_regression_coord (W : MultidimBrownianMotion P d)
    {ℱ : Filtration ℝ ‹MeasurableSpace Ω›} (hcoord : ∀ j, IsBrownianFiltration (W.W j) ℱ)
    (hjoint : ∀ ⦃s : ℝ⦄, 0 ≤ s → Indep (ℱ s) (⨆ i : Fin d, ⨆ t ∈ Set.Ioi s,
      MeasurableSpace.comap (fun ω => (W.W i).W t ω - (W.W i).W s ω) inferInstance) P)
    (k : Fin d) {t r T : ℝ} (ht : 0 ≤ t) (htr : t < r) (hrT : r ≤ T) {Φ : Ω → ℝ}
    (hΦm : StronglyMeasurable[ℱ t ⊔ (⨆ j ∈ {j : Fin d | j ≠ k}, sigmaBrownian (W.W j))
      ⊔ MeasurableSpace.comap (fun ω => (W.W k).W T ω - (W.W k).W t ω) inferInstance] Φ)
    (hΦ : MemLp Φ 2 P) :
    ∫ ω, Φ ω * ((W.W k).W r ω - (W.W k).W t ω) ∂P
      = (r - t) / (T - t) * ∫ ω, Φ ω * ((W.W k).W T ω - (W.W k).W t ω) ∂P :=
  integral_mul_increment_eq_regression (W.W k) (supOthers W ℱ k)
    (isBrownianFiltration_supOthers W hcoord hjoint k) ht htr hrT hΦm hΦ

end LevyStochCalc.Brownian
